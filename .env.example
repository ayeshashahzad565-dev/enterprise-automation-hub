# ==============================================================================
# Enterprise Automation Hub — Environment Configuration
# Copy this file to .env and populate with real values.
# Never commit a populated .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — Database, Auth, and Storage
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only. Never expose this value to the browser/Presentation Layer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Database Migrations (Alembic)
# Direct PostgreSQL connection string, used only by Alembic at migration time.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Email / SMTP — Notification Service
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_ADDRESS=notifications@example.com

# ------------------------------------------------------------------------------
# Scheduler (APScheduler, in-process)
# SCHEDULER_LEADER must be "true" on exactly one running instance.
# ------------------------------------------------------------------------------
SCHEDULER_LEADER=true
SCHEDULER_ESCALATION_INTERVAL_MINUTES=60
SCHEDULER_REMINDER_INTERVAL_HOURS=24
SCHEDULER_ANALYTICS_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# Streamlit Server
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Rate Limiting (per API-ADD Section 15)
# ------------------------------------------------------------------------------
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_5_MINUTES=10
RATE_LIMIT_NOTIFICATION_POLL_PER_MINUTE=30

# ------------------------------------------------------------------------------
# Workflow Configuration
# ------------------------------------------------------------------------------
WORKFLOW_DEFAULT_ESCALATION_HOURS=48