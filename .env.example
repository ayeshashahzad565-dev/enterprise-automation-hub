# ==============================================================================
# Enterprise Automation Hub — Environment Configuration
# Copy this file to .env and populate with real values.
# Never commit a populated .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# development | testing | staging | production. Staging/Production are held
# to an identical hardening standard: interactive API docs are disabled,
# CORS_ALLOWED_ORIGINS becomes required (no localhost fallback), and email
# dispatch is always enabled. Defaults to "development" if unset.
# ------------------------------------------------------------------------------
APP_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins. Required in
# Staging/Production (startup fails loudly if unset there, rather than
# silently falling back to the localhost default used in Development/Testing).
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase — Database, Auth, and Storage
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only. Never expose this value to the browser/Presentation Layer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Database Migrations (Alembic)
# Direct PostgreSQL connection string, used only by Alembic at migration time.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Email / SMTP — Notification Service
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_ADDRESS=notifications@example.com

# ------------------------------------------------------------------------------
# Scheduler (APScheduler, in-process)
#
# SCHEDULER_LEADER=true means "this instance participates in the
# Scheduler pool" (registers its jobs at all) — never set it on an
# app.jobs.worker process. Without REDIS_URL configured below, exactly
# one participating instance per environment must set this to "true"
# (a static, manually-enforced designation, unchanged from before Redis
# support existed). With REDIS_URL configured, more than one instance may
# set this to "true" safely: they automatically elect exactly one live
# leader via Redis, with automatic failover if it crashes — see
# docs/scheduler_distributed_coordination.md.
# ------------------------------------------------------------------------------
SCHEDULER_LEADER=true
SCHEDULER_ESCALATION_INTERVAL_MINUTES=60
SCHEDULER_REMINDER_INTERVAL_HOURS=24
# Reserved for a not-yet-implemented analytics-aggregation job — read and
# validated, but no scheduled job currently exists that uses this value.
SCHEDULER_ANALYTICS_INTERVAL_HOURS=24
# Only meaningful when REDIS_URL is set below. How long the Redis-backed
# Scheduler leader lock is held before expiring if this instance stops
# renewing it (e.g. crashes) — the window before another participating
# instance is automatically elected instead.
SCHEDULER_LEADER_LOCK_TTL_SECONDS=30
# Only meaningful when REDIS_URL is set below. How long a single job's
# distributed execution lock is held before expiring if not released —
# bounds how long a crashed instance can block another from picking up
# that job's next tick. Keep comfortably above the slowest job's realistic
# runtime in your deployment.
SCHEDULER_JOB_LOCK_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Error Tracking (optional — Sentry)
# Leave unset to disable entirely (the default for every existing
# deployment): no behavior change, no network call, nothing initialized.
# Set to a real Sentry project DSN to report unhandled exceptions from the
# API and Scheduler jobs. See app/config/error_tracking.py.
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Rate Limiting (per API-ADD Section 15)
# ------------------------------------------------------------------------------
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_5_MINUTES=10
RATE_LIMIT_NOTIFICATION_POLL_PER_MINUTE=30
# Public, unauthenticated invitation endpoints only (GET /invitations/validate,
# POST /invitations/accept) — per caller IP address, shared across both.
# See docs/api_design.md Section 15 for why this pair is IP-keyed instead
# of the usual per-authenticated-user keying. 0 blocks every request.
RATE_LIMIT_INVITATION_PUBLIC_PER_5_MINUTES=20
# Every /ai/* endpoint — deliberately tighter than the read/write limits
# above, since each call may invoke a paid, multi-second external AI
# provider request rather than a local database query.
RATE_LIMIT_AI_PER_MINUTE=20

# ------------------------------------------------------------------------------
# Workflow Configuration
# ------------------------------------------------------------------------------
WORKFLOW_DEFAULT_ESCALATION_HOURS=48

# ------------------------------------------------------------------------------
# Enterprise User Onboarding — Invitations
# APP_BASE_URL is the frontend origin used to build the acceptance link
# embedded in invitation emails (no trailing slash).
# ------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
INVITATION_EXPIRY_HOURS=72
INVITATION_ACCEPT_PATH=/accept-invite

# ------------------------------------------------------------------------------
# Redis (production infrastructure layer — optional)
# Leave unset (the default) to keep every rate limiter/cache in-process and
# email dispatch synchronous, exactly as without this section. Set REDIS_URL
# to enable a shared, multi-instance-safe rate limiter, a shared analytics
# response cache, (if EMAIL_DISPATCH_MODE=queue) the Redis-backed job
# system consumed by `python -m app.jobs.worker`, and Redis-backed dynamic
# Scheduler leader election (see the Scheduler section above).
# ------------------------------------------------------------------------------
REDIS_URL=
EMAIL_DISPATCH_MODE=direct

# ------------------------------------------------------------------------------
# Job System (app.jobs — optional, all have sensible defaults)
# WORKER_ROLE selects which queues `python -m app.jobs.worker` consumes when
# run with no --role flag: "default" (email/invitation), "escalation"
# (escalate_stage/send_reminder), or "all". Only meaningful for a worker
# process/container — ignored by the API process.
# ------------------------------------------------------------------------------
JOB_DEFAULT_MAX_ATTEMPTS=5
WORKER_ROLE=all
WORKER_METRICS_PORT=9100
STUCK_JOB_THRESHOLD_MINUTES=10
STUCK_JOB_REAPER_INTERVAL_MINUTES=5

# ------------------------------------------------------------------------------
# AI Integration (app.ai — optional)
# Leave AI_PROVIDER unset (the default) to disable every AI feature entirely:
# every /ai/* endpoint returns a deterministic, non-AI fallback instead of
# erroring, and no external call is ever made. Set AI_PROVIDER to enable —
# AI_API_KEY and AI_MODEL then become required (no default model is guessed).
# One of: openai | anthropic | groq (Groq's API is OpenAI-compatible, served
# via the same OpenAiProvider — a free-tier-friendly option; get a key at
# console.groq.com).
# ------------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# Frontend Docker build args (docker-compose.production.yml only)
# NEXT_PUBLIC_* values are baked into the frontend's JS bundle at build time
# (Next.js convention), so docker compose reads them from this root .env for
# the `frontend` service's build args — set them here identically to
# frontend/.env.local so `docker compose build frontend` picks up the same
# Supabase project. Never put secrets here; these are the public anon key,
# not the service-role key.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# Grafana (docker-compose.production.yml only)
# Required: docker-compose.production.yml has no fallback default for this
# variable — `docker compose up` refuses to start if it is unset or empty,
# rather than silently running Grafana with its well-known `admin` default
# password reachable at :3001.
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me